# ─────────────────────────────────────────────────────────────
# SEOA Travel AI Video Automation — environment variables
# Copy to .env and fill in. NEVER commit .env to git.
# ─────────────────────────────────────────────────────────────

# --- App ---
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
# If set, the web UI/API require HTTP Basic auth (username: seoa).
# Strongly recommended when opening the server to your iPad over a network.
APP_PASSWORD=

# --- Higgsfield (official API, https://docs.higgsfield.ai) ---
# mock = no network calls, no credits spent (DEFAULT)
# live = call the official Higgsfield API (requires ALLOW_PAID_API_CALLS=true too)
HIGGSFIELD_MODE=mock
# Second safety switch. Live calls are refused unless this is exactly "true".
ALLOW_PAID_API_CALLS=false
# Credentials from https://console.higgsfield.ai (a key ID + a secret).
# Option A: one variable in the form KEY_ID:KEY_SECRET
HF_API_KEY=
# Option B: two separate variables
# HF_API_KEY_ID=
# HF_API_KEY_SECRET=
HIGGSFIELD_BASE_URL=https://api.higgsfield.ai

# --- Credit saving (defaults are the cheapest settings) ---
# Allowlist + documented options: app/services/higgsfield/models.py
# Provisional cheapest: 480p, 1-second minimum. Confirm with the free cost comparison in the UI.
HIGGSFIELD_MODEL=xai/grok-imagine-video/v1.5/reference-to-video
# Empty = the model's cheapest resolution. Anything above 720p is ignored.
HIGGSFIELD_RESOLUTION=
# minimum = always the model's shortest clip; scene = the scene's own length
HIGGSFIELD_DURATION_POLICY=minimum
HIGGSFIELD_POLL_TIMEOUT_SECONDS=900
# Live jobs generate at most this many scenes (1 = test a single scene).
MAX_CLIPS_PER_JOB=1
# Approval is refused when the free estimate for a job is above this (USD).
MAX_USD_PER_JOB=1.00

# --- Video / FFmpeg ---
FFMPEG_BINARY=ffmpeg
FFPROBE_BINARY=ffprobe
VIDEO_WIDTH=1080
VIDEO_HEIGHT=1920
VIDEO_FPS=30
CTA_TEXT=Follow @staypick.kr
CTA_DURATION_SECONDS=2.5
# Korean font for burned-in subtitles. Put the .ttf/.otf in assets/fonts/
SUBTITLE_FONT_NAME=Noto Sans KR

# --- Storage ---
DATA_DIR=data
